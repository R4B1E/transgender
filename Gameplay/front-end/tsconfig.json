{
    "compilerOptions": {
        "target": "esnext",
        "module": "ESNext",
        "strict": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "outDir": "./dst",
        "moduleResolution": "node",
        "skipLibCheck": true,
        "allowJs": false,
        "rewriteRelativeImportExtensions": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dst"
    ]
}